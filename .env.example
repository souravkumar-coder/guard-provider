# ─────────────────────────────────────────────────────────────
# Guard Provider — environment variables
# Copy to `.env` (repo root). The server also reads `server/.env`.
# NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# API server
PORT=4000
NODE_ENV=development

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# CORS: comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173

# Data source: `memory` (demo, seeded in-memory store).
# Future: `postgres` / `mongo` once a real database is provisioned (see README).
DATA_SOURCE=memory
SEED_DEMO_DATA=true

# Frontend (optional): base URL of the API. Leave unset to use the Vite
# dev-server proxy (recommended) — client calls relative `/api`.
# VITE_API_URL=http://localhost:4000/api
