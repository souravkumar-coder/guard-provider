{
  "name": "@guard-provider/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Guard Provider API server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
